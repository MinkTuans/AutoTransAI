# ============================================================
# WorkflowVdAi Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Provider API Keys ---
# Only fill in providers you plan to use.
# Leave blank if not using that provider.

# Google Gemini (LLM - free tier available via AI Studio)
GEMINI_API_KEY=

# Google Cloud Text-to-Speech (requires billing-enabled GCP project)
GOOGLE_CLOUD_TTS_API_KEY=

# ElevenLabs (10,000 chars/month free)
ELEVENLABS_API_KEY=

# Kling AI (video generation)
KLING_API_KEY=

# fal.ai (video generation aggregator)
FAL_API_KEY=

# --- Application Settings ---
# Override defaults if needed (defaults shown)

# DATA_DIR=data
# MAX_CONCURRENCY=2
# MAX_RETRIES=3
# VIDEO_TARGET_DURATION=8
# AUDIO_FORMAT=wav
# VIDEO_FORMAT=mp4
# DEFAULT_SYNC_STRATEGY=trim_video

# --- Cloudflare R2 Persistent Storage ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=workflowvdai
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# --- Database Configuration ---
# Default SQLite DB file: data/workflow.db
# DATABASE_URL=sqlite+aiosqlite:///data/workflow.db

# --- Laragon MySQL / MariaDB Configuration ---
# Dùng cho Laragon (MySQL / MariaDB):
# Cú pháp: mysql+aiomysql://<user>:<password>@<host>:<port>/<db_name>
# Mặc định Laragon: user=root, password= (trống), db_name=workflowvdai
# DATABASE_URL=mysql+aiomysql://root:@127.0.0.1:3306/workflowvdai




