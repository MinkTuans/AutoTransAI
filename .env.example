# ============================================================
# WorkflowVdAi Environment Variables (Template)
# Copy this file to .env and fill in your values
# ============================================================

# --- Application Settings ---
DEFAULT_LLM_PROVIDER=gemini
ENABLE_OPENAI_FALLBACK=false

# --- Local Database & Storage Configuration ---
# Laragon MySQL (Recommended Local Production):
DATABASE_URL=mysql+aiomysql://root:@127.0.0.1:3306/autotransai
# SQLite Fallback (Offline Development):
# DATABASE_URL=sqlite+aiosqlite:///data/workflow.db

STORAGE_DRIVER=local
STORAGE_ROOT=./storage

# --- YouTube Upload Config ---
YOUTUBE_CLIENT_ID=dán_client_id_của_bạn_vào_đây
YOUTUBE_CLIENT_SECRET=dán_client_secret_của_bạn_vào_đây
ENCRYPTION_KEY=gõ_một_chuỗi_ký_tự_ngẫu_nhiên_vào_đây_để_bảo_mật_token

# --- Auto-Synchronized AI Provider API Keys ---