# ============================================================
# WorkflowVdAi Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Provider API Keys ---
# Only fill in providers you plan to use.
# Leave blank if not using that provider.

# Google Gemini (LLM - free tier available via AI Studio)
GEMINI_API_KEY=

# Google Cloud Text-to-Speech (requires billing-enabled GCP project)
GOOGLE_CLOUD_TTS_API_KEY=

# ElevenLabs (10,000 chars/month free)
ELEVENLABS_API_KEY=

# Kling AI (video generation)
KLING_API_KEY=
KLING_API_SECRET=

# fal.ai (video generation aggregator)
FAL_API_KEY=

# --- Application Settings ---
# Override defaults if needed (defaults shown)

# DATA_DIR=data
# MAX_CONCURRENCY=2
# MAX_RETRIES=3
# VIDEO_TARGET_DURATION=8
# AUDIO_FORMAT=wav
# VIDEO_FORMAT=mp4
# DEFAULT_SYNC_STRATEGY=trim_video
