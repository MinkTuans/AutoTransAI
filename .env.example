# ============================================================
# WorkflowVdAi Environment Variables (Template)
# Copy this file to .env and fill in your values
# ============================================================

# --- Primary AI Provider API Keys ---
# Google Gemini (LLM - free tier available via AI Studio)
GEMINI_API_KEY=

# OpenAI API Key (LLM, Whisper STT, TTS, DALL-E)
OPENAI_API_KEY=

# Google Cloud Text-to-Speech (requires GCP project)
GOOGLE_CLOUD_TTS_API_KEY=

# ElevenLabs (Audio TTS)
ELEVENLABS_API_KEY=

# Kling AI (Video Generation)
KLING_API_KEY=
KLING_API_KEY_2=
KLING_API_KEY_3=

# fal.ai (Video Generation Aggregator)
FAL_API_KEY=
FAL_API_KEY_2=

# --- Application Settings ---
DEFAULT_LLM_PROVIDER=gemini
ENABLE_OPENAI_FALLBACK=false

# DATA_DIR=data
# MAX_CONCURRENCY=2
# MAX_RETRIES=3
# VIDEO_TARGET_DURATION=8
# AUDIO_FORMAT=wav
# VIDEO_FORMAT=mp4
# DEFAULT_SYNC_STRATEGY=trim_video

# --- Cloudflare R2 Persistent Storage ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=workflowvdai
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# --- Database Configuration ---
# SQLite default:
DATABASE_URL=sqlite+aiosqlite:///data/workflow.db
# MySQL / MariaDB (Laragon):
# DATABASE_URL=mysql+aiomysql://root:@127.0.0.1:3306/workflowvdai
